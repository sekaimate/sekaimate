# Copy to .env, then replace production values. .env is intentionally ignored.
# Docker Compose reads this file automatically from this directory.

# Server networking
SetPort=4296
HealthCheckPort=10666
PromethusPort=1234
PeerLimit=1024
EnableStatistics=true
EnableConsole=false
Password=change-me-before-public-use

# Set to the DID that should administer the first server start, for example:
# BasisFirstAdmin=did:key:z6Mk...
BasisFirstAdmin=

# SSO is off until appsettings.json has Google and/or Okta configuration.
RequireSso=false

# The publicly reachable game host for the single meeting started by this Compose deployment.
# Required. Use 127.0.0.1 for same-machine development; set a reachable DNS/IP before sharing.
BASIS_MEETING_PUBLIC_HOST=127.0.0.1

# Local-only broker HTTP port. It is bound to 127.0.0.1 and not network-accessible.
SsoBrokerPort=5080

# Only needed for the optional public-DNS proxy profile (sso-public).
# SsoPublicHost=sso.example.com
