{
  "_comment": "Copy to Assets/StreamingAssets/basis-sso.json. clientSecret is optional for a native client and is sent only to the IdP token endpoint; never add Basis server or broker keys here.",
  "defaultProviderId": "google",
  "serverTransport": {
    "serverPublicKey": "REPLACE_WITH_SERVER_X25519_PUBLIC_KEY",
    "admissionEndpoint": "https://YOUR_BASIS_AUTH_BROKER.example/admission/YOUR_SERVER_ID"
  },
  "providers": [
    {
      "id": "google",
      "label": "Google Workspace",
      "issuer": "https://accounts.google.com",
      "clientId": "REPLACE_WITH_GOOGLE_DESKTOP_CLIENT_ID",
      "clientSecret": "OPTIONAL_GOOGLE_DESKTOP_CLIENT_SECRET",
      "scopes": ["openid", "email", "profile"],
      "extraAuthParams": { "access_type": "offline", "prompt": "consent" },
      "displayNameClaims": ["name", "email"],
      "access": { "allowedGroups": [], "allowedClaims": [] }
    },
    {
      "id": "okta",
      "label": "Okta",
      "issuer": "https://YOUR_OKTA_DOMAIN/oauth2/YOUR_AUTHORIZATION_SERVER_ID",
      "clientId": "REPLACE_WITH_OKTA_NATIVE_CLIENT_ID",
      "scopes": ["openid", "email", "profile", "offline_access", "basis.connect"],
      "displayNameClaims": ["name", "preferred_username", "email"],
      "access": { "allowedGroups": [], "allowedClaims": [] }
    }
  ],
  "redirect": {
    "mode": "loopback",
    "host": "127.0.0.1",
    "port": 42800,
    "path": "/callback"
  },
  "enforcement": {
    "allowOfflineWithinTokenValidity": true
  }
}
