# Minikube開発用の環境変数
# このファイルを .env.local にコピーして値を設定してください。

# local/BEE/world.BEE の解除パスワード（必須）
BASIS_WORLD_BEE_PASSWORD=

# ブラウザから見えるBEEのURL。通常は変更不要です。
BASIS_WORLD_BEE_URL=http://127.0.0.1:4173/BEE/world.BEE

# Admin ConsoleのBearer token（任意。空なら初回起動時に自動生成）
CONCIERGE_ADMIN_TOKEN=

# 任意: k8s:upが使うWebGLイメージ。既定はGHCRの公開イメージです。
# WEB_IMAGE=ghcr.io/sekaimate/concierge-web:dev

# 任意: web:publishが使うコンテナエンジン。未設定ならPodman、無ければDockerを使います。
# CONTAINER_ENGINE=podman

# 任意: Minikubeのプロファイル名とコンテナドライバー
# MINIKUBE_PROFILE=minikube
# MINIKUBE_DRIVER=docker
